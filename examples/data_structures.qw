public func main() {
    // Literal declarations without any imports
    const names = ["Qwic", "Lang"]
    const values = {"name": "Qwic", "kind": "language"}
    const pair = ("Qwic", "language")

    print(f"list item 0={names[0]}")
    print(f"list item 1={names[1]}")
    const kind = values["kind"]
    print(f"dictionary kind={kind}")
    print(f"tuple={pair[0]}:{pair[1]}")

    // Direct printing of data structures
    print(names)
    print(values)
    print(pair)
}
